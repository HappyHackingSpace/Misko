# Environment for docker-compose.yml. Every variable here is optional: the
# defaults below are what compose uses when the variable is unset.
#
# The database credentials are fixed in docker-compose.yml because that stack is
# for local development only. The Go processes never read a .env file; compose
# passes these through as environment variables.

# Signs login tokens. Any value works locally; use at least 32 random bytes
# (for example `openssl rand -base64 48`) anywhere that is not your own machine.
JWT_SECRET=local-development-only-signing-secret

# `bootstrap setup` reads these when it creates the laboratory and the first
# administrator. The password is generated, never taken from here.
ADMIN_EMAIL=admin@misko.local
LAB_NAME=Misko Laboratory
LAB_TIMEZONE=UTC

# Host port for the web panel.
FRONTEND_PORT=8080

# How often the jobs process queues analysis runs and requeues expired leases.
JOB_INTERVAL=10s

# Video storage. Without a bucket the upload and read routes answer 503 and the
# rest of the API works normally.
GCS_BUCKET=
GCS_SIGNER_EMAIL=

# Local development only: with this set, the `setup` command also registers a
# "dev-worker" whose token is exactly this value, and the `worker` profile uses
# it when MISKO_WORKER_TOKEN is empty - so `docker compose --profile worker up`
# needs no manual registration. The value below is public and carries no
# secret; `setup` refuses to seed it when APP_ENV=production.
WORKER_BOOTSTRAP_TOKEN=mw_dev_local_only_not_a_secret

# Only needed for the `worker` profile when not using the seed above: the token
# of a worker registered with `bootstrap register-worker` or in the API.
MISKO_WORKER_TOKEN=
