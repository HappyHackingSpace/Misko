# docker-compose ortam değişkenleri

# PostgreSQL
POSTGRES_USER=misko
POSTGRES_PASSWORD=misko
POSTGRES_DB=misko
DB_PORT=5432

# Backend
BACKEND_PORT=4000
JWT_SECRET=change-me-in-production
JWT_TTL=7d
CORS_ORIGIN=*
# Superadmin bootstrap: ilk açılışta bu e-posta ile admin oluşturulur,
# güçlü şifre sistem tarafından üretilip backend log'una bir kez yazılır.
ADMIN_EMAIL=admin@fare.lab
# Laboratuvar (kiracı) adı — arayüzde markalama için gösterilir
LAB_NAME=Mişko Laboratuvarı

# Frontend (nginx) host portu
FRONTEND_PORT=8080
