# Optional env file for the `backend` service only (see docker-compose.prod.yml).
# Without it, videos are kept on the `videos` volume of this machine and nothing
# needs to be configured. Copy to `storage.env` next to docker-compose.prod.yml
# only to use a Google Cloud Storage bucket instead. Videos already on the
# volume are not moved to the bucket.

# Private GCS bucket name. A bucket takes precedence over the local volume.
GCS_BUCKET=

# Service account that signs upload/read URLs through the IAM Credentials API.
# Can be the VM's own attached service account - it needs Storage Object Admin
# on the bucket and Service Account Token Creator on itself.
GCS_SIGNER_EMAIL=
