# Env file for the `backend` service only (see docker-compose.prod.yml). Copy
# to `storage.env` next to docker-compose.prod.yml.
#
# Unlike `.env` (database password, JWT secret), this file is meant to be
# overwritten freely: neither value here is a rotating secret, so redeploying
# with the same or corrected values is always safe.

# Private GCS bucket name. Without it the video upload and read routes answer
# 503 and the rest of the system works normally.
GCS_BUCKET=

# Service account that signs upload/read URLs through the IAM Credentials API.
# Can be the VM's own attached service account - it needs Storage Object Admin
# on the bucket and Service Account Token Creator on itself.
GCS_SIGNER_EMAIL=
