# PostgreSQL bağlantısı (docker-compose ile birebir uyumlu)
DATABASE_URL="postgresql://misko:misko@localhost:5432/misko?schema=public"

# JWT imzalama anahtarı — üretimde uzun, rastgele bir değer kullanın
JWT_SECRET="dev-secret-change-me"
JWT_TTL="7d"

# Sunucu
PORT=4000
NODE_ENV=development

# CORS (virgülle ayrılmış kökenler veya *)
CORS_ORIGIN="*"

# bcrypt tur sayısı
BCRYPT_ROUNDS=10

# Superadmin bootstrap (Docker açılışında) — e-posta verilir, şifreyi sistem üretir
ADMIN_EMAIL="admin@fare.lab"

# Laboratuvar (kiracı) adı — arayüzde markalama için gösterilir
LAB_NAME="Mişko Laboratuvarı"
