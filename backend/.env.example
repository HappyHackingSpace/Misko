# Export these variables explicitly; the Go processes do not read .env files.
DATABASE_URL=postgres://misko:misko_test_only@127.0.0.1:5432/misko_foundation?sslmode=disable
HTTP_ADDR=:4000
PROBE_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# API authentication. JWT_SECRET must contain at least 32 random bytes,
# for example the output of `openssl rand -base64 48`.
JWT_SECRET=
JWT_ISSUER=misko
JWT_AUDIENCE=misko-api
TOKEN_TTL=12h
BCRYPT_COST=12

# `bootstrap setup` only.
ADMIN_EMAIL=admin@misko.local
LAB_NAME=Misko Laboratory
LAB_TIMEZONE=UTC
