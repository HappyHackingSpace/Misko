// Mişko - data model (PostgreSQL)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Laboratory (single tenant / on-prem singleton). Exactly ONE row per install;
// creating a second laboratory is rejected at the application layer (see
// bootstrap-admin.js and src/modules/lab, docs/DOMAIN.md §0).
model Laboratory {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique // short institutional code (optional)
  timezone  String   @default("Europe/Istanbul")
  settings  Json     @default("{}") // free-form configuration (branding etc.)
  createdAt DateTime @default(now())

  environments Environment[]
}

// Environment (test setup / "Ortam"). A named, persisted instance created FROM a
// paradigm template. A lab can hold MANY environments per paradigm (e.g. two
// distinct Morris water tanks). The physical configuration is captured as a full,
// self-contained snapshot in `config` and is LOCKED at test time (a test cannot
// override an environment's physical values). The paradigm DEFINITION still lives
// in code (src/config/paradigms.js); only the chosen VALUES are stored here.
model Environment {
  id           String     @id @default(cuid())
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  laboratoryId String
  name         String // operator-given name, e.g. "Tank A"
  paradigmKey  String // MWM | OPEN_FIELD | ... (registry key)
  // Full resolved snapshot: { paradigmKey, schemaVersion, apparatus: {...}, zones: [...] }
  config       Json
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([laboratoryId])
  @@index([paradigmKey])
}

// User (comes via auth). The role drives the code-embedded permission matrix
// (see src/config/permissions.js, docs/DOMAIN.md §5b).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  // SUPERADMIN | LAB_MANAGER | RESEARCHER | TECHNICIAN | VIEWER
  role      String   @default("RESEARCHER")
  createdAt DateTime @default(now())
  tests     Test[]
}

// Test device (phone)
model Device {
  id         String    @id @default(cuid())
  name       String
  platform   String? // ios | android | ...
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  tests      Test[]
}

// Subject / Mouse. Research-grade domain model (see docs/DOMAIN.md §2). Fields
// marked "CV" matter to computer vision (contrast against the apparatus surface).
model Subject {
  id           String    @id @default(cuid())
  // Identity
  code         String    @unique // lab ID / cage label
  microchipId  String? // RFID / transponder
  earTag       String?
  // Biological
  species      String    @default("Mus musculus")
  strain       String? // background strain, e.g. C57BL/6J, BALB/c
  line         String? // transgenic line, e.g. 5xFAD, APP/PS1, WT
  genotype     String?
  zygosity     String? // WT | HET | HOMO
  sex          String? // M | F
  birthDate    DateTime? // age is derived, not stored
  coatColor    String? // black | agouti | albino_white | brown | other (CV: contrast)
  // Physiology
  healthStatus String?
  notes        String?
  // Housing & social
  cageId       String?
  litter       String?
  cohort       String?
  // Lifecycle
  status       String    @default("ALIVE") // ALIVE | SACRIFICED | DEAD
  acquiredAt   DateTime?
  sacrificedAt DateTime?
  // Experiment grouping (interim free-text label; replaced by SubjectGroup in a
  // later step, see docs/DOMAIN.md §4).
  groupName    String?
  createdAt    DateTime  @default(now())

  tests      Test[]
  weightLogs WeightLog[]

  @@index([status])
  @@index([strain])
}

// WeightLog: subject weight time series. Many protocols weigh daily (food/water
// restriction, drug dosing). Canonical unit is grams (see backend/src/config/units.js).
model WeightLog {
  id         String   @id @default(cuid())
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  String
  measuredAt DateTime @default(now())
  grams      Float
  notes      String?
  createdAt  DateTime @default(now())

  @@index([subjectId])
}

// Test scenario (pool / maze / stick / path)
model Scenario {
  id          String   @id @default(cuid())
  name        String
  type        String // POOL | MAZE | STICK | PATH
  description String?
  config      String? // JSON: geometry / acceptance criteria (content later)
  createdAt   DateTime @default(now())
  tests       Test[]
}

// Test (running a scenario with a subject, on a device, by an operator)
model Test {
  id                 String    @id @default(cuid())
  scenario           Scenario  @relation(fields: [scenarioId], references: [id])
  scenarioId         String
  subject            Subject   @relation(fields: [subjectId], references: [id])
  subjectId          String
  operator           User      @relation(fields: [operatorId], references: [id])
  operatorId         String
  device             Device?   @relation(fields: [deviceId], references: [id])
  deviceId           String?
  status             String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  startedAt          DateTime?
  endedAt            DateTime?
  result             String? // JSON: metrics
  passed             Boolean? // evaluation result when acceptance criteria exist; null if no criteria
  acceptanceCriteria String? // JSON: user-defined acceptance criteria [{ metricKey, operator, value }]
  notes              String?
  createdAt          DateTime  @default(now())

  // Postgres does not auto-index FK columns; we add these for list/filter queries
  @@index([scenarioId])
  @@index([subjectId])
  @@index([operatorId])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}
