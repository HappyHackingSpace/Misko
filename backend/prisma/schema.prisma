// Mişko — veri modeli (PostgreSQL)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Kullanıcı (auth ile gelir). Rol koda gömülü izin matrisini sürer (bkz.
// src/config/permissions.js, docs/DOMAIN.md §5b).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  // SUPERADMIN | LAB_MANAGER | RESEARCHER | TECHNICIAN | VIEWER
  role      String   @default("RESEARCHER")
  createdAt DateTime @default(now())
  tests     Test[]
}

// Test cihazı (telefon)
model Device {
  id         String    @id @default(cuid())
  name       String
  platform   String? // ios | android | ...
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  tests      Test[]
}

// Denek / Fare
model Subject {
  id        String    @id @default(cuid())
  code      String    @unique // kafes/etiket kodu
  sex       String? // M | F
  groupName String? // deney grubu
  birthDate DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  tests     Test[]
}

// Test senaryosu (havuz / labirent / sopa / yol)
model Scenario {
  id          String   @id @default(cuid())
  name        String
  type        String // POOL | MAZE | STICK | PATH
  description String?
  config      String? // JSON: geometri / kabul kriterleri (içerik sonra)
  createdAt   DateTime @default(now())
  tests       Test[]
}

// Test (bir senaryonun bir denekle, bir cihazda, bir operatörce koşulması)
model Test {
  id         String    @id @default(cuid())
  scenario   Scenario  @relation(fields: [scenarioId], references: [id])
  scenarioId String
  subject    Subject   @relation(fields: [subjectId], references: [id])
  subjectId  String
  operator   User      @relation(fields: [operatorId], references: [id])
  operatorId String
  device     Device?   @relation(fields: [deviceId], references: [id])
  deviceId   String?
  status     String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  startedAt  DateTime?
  endedAt    DateTime?
  result     String? // JSON: metrikler
  passed     Boolean? // kabul kriterleri varsa degerlendirme sonucu; kriter yoksa null
  acceptanceCriteria String? // JSON: kullanici tanimli kabul kriterleri [{ metricKey, operator, value }]
  notes      String?
  createdAt  DateTime  @default(now())

  // Postgres FK kolonlarına otomatik index koymaz; liste/filtre sorguları için ekliyoruz
  @@index([scenarioId])
  @@index([subjectId])
  @@index([operatorId])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}
