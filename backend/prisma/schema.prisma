// Mişko - data model (PostgreSQL)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Laboratory (single tenant / on-prem singleton). Exactly ONE row per install;
// creating a second laboratory is rejected at the application layer (see
// bootstrap-admin.js and src/modules/lab, docs/DOMAIN.md §0).
model Laboratory {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique // short institutional code (optional)
  timezone  String   @default("Europe/Istanbul")
  settings  Json     @default("{}") // free-form configuration (branding etc.)
  createdAt DateTime @default(now())

  environments Environment[]
}

// Environment (test setup / "Ortam"). A named, persisted instance created FROM a
// paradigm template. A lab can hold MANY environments per paradigm (e.g. two
// distinct Morris water tanks). The physical configuration is captured as a full,
// self-contained snapshot in `config` and is LOCKED at test time (a test cannot
// override an environment's physical values). The paradigm DEFINITION still lives
// in code (src/config/paradigms.js); only the chosen VALUES are stored here.
model Environment {
  id           String     @id @default(cuid())
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  laboratoryId String
  name         String // operator-given name, e.g. "Tank A"
  paradigmKey  String // MWM | OPEN_FIELD | ... (registry key)
  // Full resolved snapshot: { paradigmKey, schemaVersion, apparatus: {...}, zones: [...] }
  config       Json
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  scenarios Scenario[] // N-N: an environment can be used by many scenarios

  @@index([laboratoryId])
  @@index([paradigmKey])
}

// User (comes via auth). The role drives the code-embedded permission matrix
// (see src/config/permissions.js, docs/DOMAIN.md §5b).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  // SUPERADMIN | LAB_MANAGER | RESEARCHER | TECHNICIAN | VIEWER
  role      String   @default("RESEARCHER")
  createdAt DateTime @default(now())
  tests     Test[]
  comments  Comment[]
}

// Subject / Mouse
model Subject {
  id        String    @id @default(cuid())
  code      String    @unique // cage/tag code
  sex       String? // M | F
  groupName String? // experiment group
  birthDate DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  tests     Test[]
}

// Scenario - the central experiment definition (see docs/DOMAIN.md §3).
// A scenario bundles one or more Environments (so it can span one or more
// paradigms) with the expected results to evaluate. A Test = Subject + Scenario,
// run once; metrics are evaluated against the scenario's acceptance criteria.
model Scenario {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // Optional free-form session parameters (trial count, duration, ...).
  sessionParams Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environments Environment[] // N-N: a scenario runs on one or more environments
  tests        Test[]
}

// Test (running a scenario with a subject, by an operator)
model Test {
  id                 String    @id @default(cuid())
  scenario           Scenario  @relation(fields: [scenarioId], references: [id])
  scenarioId         String
  subject            Subject   @relation(fields: [subjectId], references: [id])
  subjectId          String
  operator           User      @relation(fields: [operatorId], references: [id])
  operatorId         String
  status             String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  startedAt          DateTime?
  endedAt            DateTime?
  result             Json? // per-environment metric results (manual or CV)
  notes              String?
  createdAt          DateTime  @default(now())

  comments           Comment[]

  // Postgres does not auto-index FK columns; we add these for list/filter queries
  @@index([scenarioId])
  @@index([subjectId])
  @@index([operatorId])
  @@index([status])
  @@index([createdAt])
}

// Comment - free-form discussion thread attached to a Test. Any authenticated
// user can post (see docs/DOMAIN.md, the permission matrix only gates deletion).
// `body` is stored as raw text; it is never interpreted as HTML. The frontend
// renders it with text interpolation (auto-escaped), so stored content cannot
// execute. Validation (length, control-char stripping) happens at the API layer
// (src/modules/comments/comment.validation.js).
model Comment {
  id        String   @id @default(cuid())
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String // raw user text, max length enforced at the API layer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId])
  @@index([authorId])
  @@index([createdAt])
}
