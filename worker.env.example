# Env file for the `worker` service only (see docker-compose.prod.yml). Copy to
# `worker.env` next to docker-compose.prod.yml.
#
# Unlike `.env` (database password, JWT secret), this file is meant to be
# overwritten freely: the token below carries no other state, so redeploying
# with a new one is always safe.

# Shown once in the response to `POST /api/analysis/workers` (needs
# `lab:configure`). Until this is a real token, the worker container exits
# repeatedly instead of running - harmless, just noisy in `docker compose logs`.
MISKO_WORKER_TOKEN=
