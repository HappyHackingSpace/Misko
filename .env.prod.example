# Pull-based deployment env (copy to `.env` next to docker-compose.prod.yml).

# GHCR image source. Defaults work for the official repo; override only if you
# pushed the images somewhere else.
IMAGE_OWNER=happyhackingspace
IMAGE_TAG=latest

# PostgreSQL (data stays in the db-data volume)
POSTGRES_USER=misko
POSTGRES_PASSWORD=change-me
POSTGRES_DB=misko

# Backend
JWT_SECRET=change-me-in-production
JWT_TTL=7d
CORS_ORIGIN=*
# Superadmin bootstrap: on first boot an admin is created with this email and a
# strong password is generated and printed once to the backend log.
ADMIN_EMAIL=admin@fare.lab
# Lab (tenant) name shown in the UI
LAB_NAME=Mişko Laboratuvarı

# Host port for the web UI (open http://localhost:8080)
FRONTEND_PORT=8080
