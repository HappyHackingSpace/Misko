# Pull-based deployment env (copy to `.env` next to docker-compose.prod.yml).

# GHCR image source. Defaults work for the official repo; override only if you
# pushed the images somewhere else. For a reproducible deploy, pin IMAGE_TAG to a
# released version (e.g. 1.0.0) instead of `latest`.
IMAGE_OWNER=happyhackingspace
IMAGE_TAG=latest

# PostgreSQL (data stays in the db-data volume)
POSTGRES_USER=misko
POSTGRES_PASSWORD=change-me          # REQUIRED: set a strong value (compose refuses to start otherwise)
POSTGRES_DB=misko

# Signs login tokens. REQUIRED: at least 32 random bytes, for example the output
# of `openssl rand -base64 48`. Compose refuses to start without it.
JWT_SECRET=change-me-in-production
# How long a signed-in session stays valid.
TOKEN_TTL=12h

# `bootstrap setup` reads these once, when it creates the laboratory and the
# first administrator. The password is generated and printed to your terminal at
# that moment; it is never taken from here and never written to a log.
ADMIN_EMAIL=admin@misko.local
LAB_NAME=Misko Laboratory
LAB_TIMEZONE=UTC

# How often the jobs process queues analysis runs and requeues expired leases.
JOB_INTERVAL=10s

# Video storage. Without a bucket the upload and read routes answer 503 and the
# rest of the system works normally.
GCS_BUCKET=
GCS_SIGNER_EMAIL=

# Host port for the web UI (open http://localhost:8080)
FRONTEND_PORT=8080
