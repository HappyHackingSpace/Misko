# Pull-based deployment env (copy to `.env` next to docker-compose.prod.yml).

# GHCR image source. Defaults work for the official repo; override only if you
# pushed the images somewhere else. For a reproducible deploy, pin IMAGE_TAG to a
# released version (e.g. 1.0.0) instead of `latest`.
IMAGE_OWNER=happyhackingspace
IMAGE_TAG=latest

# PostgreSQL (data stays in the db-data volume)
POSTGRES_USER=misko
POSTGRES_PASSWORD=change-me          # REQUIRED: set a strong value (compose refuses to start otherwise)
POSTGRES_DB=misko

# Backend
JWT_SECRET=change-me-in-production   # REQUIRED: set a strong random value (compose refuses to start otherwise)
JWT_TTL=7d
# Lock this down to the UI origin in a real deployment instead of "*"
CORS_ORIGIN=*
# Superadmin bootstrap: on first boot an admin is created with this email and a
# strong password is generated and printed once to the backend log.
ADMIN_EMAIL=admin@miskolab.com
# Lab (tenant) name shown in the UI
LAB_NAME=Mişko Laboratuvarı

# Host port for the web UI (open http://localhost:8080)
FRONTEND_PORT=8080
